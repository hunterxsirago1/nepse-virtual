# NEPSE Virtual Trading Simulator - Environment Configuration
# Copy this file to .env and fill in values

# Flask
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# Database
DATABASE_URL=sqlite:///nepse_sim.db
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/nepse_sim

# Market Hours (set to true for testing, false for real NEPSE hours)
DEBUG_MARKET_OPEN=true

# Scraper settings
SCRAPER_INTERVAL=60
SCRAPER_TIMEOUT=15

# Logging
LOG_LEVEL=INFO
